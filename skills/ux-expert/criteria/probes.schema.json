{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youmssi/ux-expert/skills/ux-expert/criteria/probes.schema.json",
  "title": "ux-expert code search probes for native mobile stacks",
  "type": "object",
  "additionalProperties": false,
  "required": ["platforms", "probes"],
  "properties": {
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "extensions", "detect", "sources", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "extensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z]+$"}},
          "detect": {"description": "How scripts/probe.py decides the platform is present.", "type": "string", "minLength": 1},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "notes": {"description": "What an agent would get wrong about this platform without being told.", "type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "kind", "pattern", "look_for", "criteria", "example"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "platform": {"type": "string"},
          "kind": {"enum": ["inventory", "review", "smell"]},
          "pattern": {"description": "A regular expression valid in Python re and ripgrep: no lookaround, no backreferences.", "type": "string", "minLength": 1},
          "look_for": {"type": "string", "minLength": 1},
          "criteria": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2,}$"}},
          "example": {"description": "A line the pattern must match.", "type": "string", "minLength": 1},
          "counter_example": {"description": "A line the pattern must not match; required for review and smell probes.", "type": "string", "minLength": 1}
        },
        "if": {"properties": {"kind": {"enum": ["review", "smell"]}}},
        "then": {"required": ["counter_example"]}
      }
    }
  }
}
