{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youmssi/ux-expert/skills/ux-expert/criteria/stack.schema.json",
  "title": "ux-expert stack pack: what a framework, component library or test tool changes about UX findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind", "summary", "detect", "verified", "evidence", "gotchas"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "kind": {"enum": ["framework", "component-library", "testing"]},
    "summary": {"description": "When to read this pack and what it changes, in one or two sentences.", "type": "string", "minLength": 1},
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "dependencies": {"description": "package.json dependency names; any one present means the stack is used.", "type": "array", "minItems": 1, "items": {"type": "string"}},
        "files": {"description": "File names at the project root; any one present means the stack is used.", "type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "verified": {
      "description": "What the pack was checked against. Content is summarized from the project's own repository at this commit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "repository", "commit", "verified_on"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "verified_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "also": {
          "description": "Other repositories read for this pack.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "commit"],
            "properties": {
              "repository": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$"},
              "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        }
      }
    },
    "evidence": {
      "description": "Where UX evidence lives in a project that uses this stack.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["what", "where"],
        "properties": {
          "what": {"type": "string", "minLength": 1},
          "where": {"type": "string", "minLength": 1}
        }
      }
    },
    "gotchas": {
      "description": "Behaviour that defies a reasonable assumption, each traced to a file in the verified repository.",
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "criteria", "source"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "criteria": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2,}$"}},
          "source": {"description": "Path in the verified repository (or 'owner/repo:path' for a repository in 'also').", "type": "string", "minLength": 1}
        }
      }
    },
    "extensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z]+$"}},
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "pattern", "look_for", "criteria", "example"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "kind": {"enum": ["inventory", "review", "smell"]},
          "pattern": {"type": "string", "minLength": 1},
          "look_for": {"type": "string", "minLength": 1},
          "criteria": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2,}$"}},
          "example": {"type": "string", "minLength": 1},
          "counter_example": {"type": "string", "minLength": 1}
        },
        "if": {"properties": {"kind": {"enum": ["review", "smell"]}}},
        "then": {"required": ["counter_example"]}
      }
    },
    "recipes": {
      "description": "Short, verified code recipes, e.g. a regression guard for a criterion.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "criteria", "language", "code"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2,}$"}},
          "language": {"enum": ["ts", "tsx", "js", "bash"]},
          "code": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "if": {"required": ["probes"]},
  "then": {"required": ["extensions"]}
}
