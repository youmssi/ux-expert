{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youmssi/ux-expert/skills/ux-expert/criteria/scoring.schema.json",
  "title": "ux-expert scoring rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["priority_matrix", "low_confidence_drop", "quick_win", "launch_gate"],
  "properties": {
    "priority_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["S4", "S3", "S2", "S1", "S0"],
      "patternProperties": {
        "^S[0-4]$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["R3", "R2", "R1"],
          "patternProperties": {"^R[1-3]$": {"enum": ["P0", "P1", "P2", "P3"]}}
        }
      }
    },
    "low_confidence_drop": {"type": "integer", "minimum": 0, "maximum": 3},
    "quick_win": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priorities", "efforts"],
      "properties": {
        "priorities": {"type": "array", "items": {"enum": ["P0", "P1", "P2", "P3"]}},
        "efforts": {"type": "array", "items": {"enum": ["XS", "S", "M", "L", "XL"]}}
      }
    },
    "launch_gate": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verdict", "when_any", "rule"],
        "properties": {
          "verdict": {"enum": ["No-Go", "Conditional Go", "Go"]},
          "when_any": {
            "type": "array",
            "items": {"enum": ["open_p0", "critical_flow_unverified", "unowned_p1", "critical_criteria_not_verified"]}
          },
          "rule": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
