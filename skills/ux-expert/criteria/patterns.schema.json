{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youmssi/ux-expert/skills/ux-expert/criteria/patterns.schema.json",
  "title": "ux-expert proven patterns from public design systems",
  "type": "object",
  "additionalProperties": false,
  "required": ["design_systems", "patterns"],
  "properties": {
    "design_systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "repository", "commit"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "pattern": "^https://github\\.com/"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "design_system", "source", "observed_on", "rule", "criteria"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "design_system": {"type": "string"},
          "source": {"type": "string", "pattern": "^https://github\\.com/.+/blob/[0-9a-f]{40}/"},
          "observed_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "rule": {"description": "The pattern's rule, summarized in our own words.", "type": "string", "minLength": 1},
          "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2,}$"}}
        }
      }
    }
  }
}
